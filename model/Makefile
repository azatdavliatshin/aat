# ProVerif models.  `make` runs every .pv file and writes out/<name>.txt;
# `make summary` collects the RESULT lines into out/SUMMARY.md.
#
# A model <profile>[-variant][.expectfalse].pv is run with the libraries
# common.pvl and <profile>.pvl.  The run fails if any query of a normal
# model is false or cannot be proved, and if no query of an
# .expectfalse.pv model is false.  For .expectfalse.pv models the
# derivations of the false queries go to out/<name>.trace.txt.

PROVERIF ?= proverif
SHELL := /bin/bash
.SECONDEXPANSION:

MODELS := $(sort $(wildcard *.pv))
NAMES  := $(MODELS:.pv=)
OUTS   := $(addprefix out/,$(addsuffix .txt,$(NAMES)))

all: $(OUTS)
	@status=0; \
	for n in $(NAMES); do \
	  f=out/$$n.txt; \
	  case $$n in \
	    *.expectfalse) \
	      if ! grep -q '^RESULT .* is false\.$$' $$f; then \
	        echo "FAIL $$n: expected a false query, none found"; status=1; fi ;; \
	    *) \
	      if grep -Eq '^RESULT .* (is false|cannot be proved)\.$$' $$f; then \
	        echo "FAIL $$n: a query is false or cannot be proved"; status=1; fi ;; \
	  esac; \
	done; \
	exit $$status

out/%.txt: %.pv common.pvl $$(firstword $$(subst -, ,$$(basename $$*))).pvl | out
	@lib=$(firstword $(subst -, ,$(basename $*))); \
	echo "proverif $*.pv"; \
	start=$$(date +%s); \
	$(PROVERIF) -lib common -lib $$lib $*.pv > $@.tmp 2>&1 || { tail -20 $@.tmp; rm -f $@.tmp; exit 1; }; \
	end=$$(date +%s); \
	mv $@.tmp $@; \
	echo $$((end - start)) > out/$*.seconds; \
	case $* in *.expectfalse) \
	  awk '/^Starting query/ { buf = "" } { buf = buf $$0 "\n" } \
	       /^RESULT .* is false\.$$/ { printf "%s\n", buf }' $@ > out/$*.trace.txt ;; \
	esac

summary: all
	@{ echo "# ProVerif results"; echo; \
	   echo "Generated by \`make summary\` ($$($(PROVERIF) -help 2>&1 | head -1 | cut -d. -f1-2))."; echo; \
	   echo "| Model | Seconds | Result |"; echo "|---|---|---|"; \
	   for n in $(NAMES); do \
	     s=$$(cat out/$$n.seconds); \
	     grep '^RESULT' out/$$n.txt | sed -e 's/^RESULT //' -e 's/^(\(.*\))$$/\1/' -e 's/|/\\|/g' \
	       | while read -r line; do echo "| $$n | $$s | \`$${line% is *}\` is $${line##* is } |"; done; \
	   done; } > out/SUMMARY.md
	@cat out/SUMMARY.md

out:
	mkdir -p out

clean:
	rm -rf out

.PHONY: all summary clean

(* common.pvl — shared theory for offline attenuating delegation chains.

   Symbolic (Dolev-Yao) model. Tokens are terms; the attacker controls the
   network, can read every token and PoP, can create keys and names of its
   own, and can learn honest holder keys through the compromise process of
   the profile file.  Nothing here is specific to one draft except where
   stated; the Verifier is parameterised by the checks a profile turns on.

   Bounded encodings (see model/README.md):
   - depths, maximum depths and expiry times range over {0,1,2,3}; chains
     therefore have at most 4 tokens (depth 0..3);
   - capabilities are subsets of a three-tool alphabet {ta, tb, tc};
     argument constraints (AAT-01 I4 constraint lattice) are not modelled.
*)

(* ---- Keys and signatures ---- *)

type skey.
type pkey.

fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; getmess(sign(m, k)) = m.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), pk(k)) = m.

(* Hash: free constructor, one-way and collision-free by construction. *)
fun h(bitstring): bitstring.

(* Issuer identifiers: a root issuer URI, or the thumbprint of a key. *)
type ident.
fun thumb(pkey): ident.
const anchor_uri: ident.

(* The single trust anchor.  Its key is never compromised. *)
free skA: skey [private].

(* ---- Bounded naturals: depth, max depth, expiry ----
   ProVerif's built-in nat (0, +1, <=), not an enumerated zero/succ/leq
   theory: the enumerated clauses multiply out across links and exhausted
   memory (see README.md, "Simplifications"). *)

(* MAX_DELEGATION_DEPTH of the verifier is 3; 3 is also the largest
   expiry value.  Written as the literal 3 below. *)

(* ---- Capabilities: subsets of {ta, tb, tc} ----
   cs(a, b, c) contains ta iff a >= 1, tb iff b >= 1, tc iff c >= 1.
   subset is pointwise <=; honest roles only produce 0/1 entries. *)

type tool.
const ta, tb, tc: tool.

type caps.
fun cs(nat, nat, nat): caps [data].

(* ---- Tokens ----
   tok(jti, iss, cnf, del_depth, del_max_depth, exp, tools, par_hash),
   carried as sign(tok(...), signing key).  par_hash covers the payload
   (the signing input), not the signature (B18).  iat, now, aud and the
   argument constraints are not modelled. *)

fun tok(bitstring, ident, pkey, nat, nat, nat, caps, bitstring): bitstring [data].
const nopar: bitstring.

(* PoP payload: popm(pop_jti, aat_id, aat_tool, hta).  The PoP commits to
   the leaf jti only, not to the chain (B23). *)
fun popm(bitstring, bitstring, tool, bitstring): bitstring [data].

(* ---- Events ---- *)

event Minted(bitstring).                 (* root payload issued by the anchor *)
event Granted(bitstring, caps).          (* root jti, root tools *)
event Derived(bitstring, bitstring).     (* honest holder derived child from parent (payloads) *)
event Invoked(pkey, bitstring, tool, bitstring, bitstring).
                                         (* holder key, leaf jti, tool, args, pop jti *)
event HonestKey(pkey).                   (* key generated by an honest holder *)
event Corrupt(pkey).                     (* honest holder key handed to the attacker *)

event AcceptedRoot(bitstring).               (* root payload of an accepted chain *)
event AcceptedLink(bitstring, bitstring).    (* parent, child payloads of an accepted chain *)
event Accept(bitstring, bitstring, tool, bitstring, bitstring).
                                         (* root payload, leaf payload, tool, args, pop jti *)

free c: channel.

(* ---- Verifier, §7 of AAT-01, parameterised by the profile's link checks ----
   i5: check par_hash (I5);  i6: verify the PoP signature (I6).
   I1 (child signed under parent.cnf, iss = thumb(parent.cnf)), I2, I3 (exp
   only) and I4 (tool sets) are always checked. *)

(* Step 3: root.  Signed by the anchor, del_depth 0, no par_hash,
   del_max_depth <= MAX_DELEGATION_DEPTH, exp in the bounded domain. *)
letfun check_root(s: bitstring) =
  let r = checksign(s, pk(skA)) in
  let tok(j, i, k, d, m, e, t, p) = r in
  if i = anchor_uri && d = 0 && p = nopar && m <= 3 && e <= 3
  then r.

(* Step 4: one adjacent pair. *)
letfun check_link(i5: bool, pp: bitstring, s: bitstring) =
  let tok(pj, pi, pkp, pd, pm, pe, cs(p1, p2, p3), ppar) = pp in
  let cp = checksign(s, pkp) in                                  (* I1, 4b *)
  let tok(cj, ci, ck, cd, cm, ce, cs(c1, c2, c3), cpar) = cp in
  if ci = thumb(pkp)                                             (* I1, 4c *)
     && cd = pd + 1                                              (* I2, 4d *)
     && cd <= pm                                                 (* I2, 4e *)
     && cd <= 3                                                  (* I2, 4f *)
     && cm <= pm                                                 (* I2, 4g *)
     && cd <= cm                                                 (* I2, 4m *)
     && ce <= pe                                                 (* I3, 4h *)
     && c1 <= p1 && c2 <= p2 && c3 <= p3                         (* I4, 4p1 *)
     && (i5 = false || cpar = h(pp))                             (* I5, 4q *)
  then cp.

(* Steps 6 and 7: leaf capability and PoP.  Without I6 the PoP payload is
   read but its signature is not checked. *)
letfun pop_payload(i6: bool, pop: bitstring, k: pkey) =
  if i6 then checksign(pop, k) else getmess(pop).

letfun has_tool(x: tool, t: caps) =
  let cs(n1, n2, n3) = t in
  (x = ta && n1 >= 1) || (x = tb && n2 >= 1) || (x = tc && n3 >= 1).

let Leaf(i6: bool, r: bitstring, l: bitstring, x: tool, a: bitstring, pop: bitstring) =
  let tok(lj, li, lk, ld, lm, le, lt, lp) = l in
  if has_tool(x, lt) then                                        (* 6b *)
  let popm(pj, aid, ptool, pargs) = pop_payload(i6, pop, lk) in  (* I6, 7b *)
  if aid = lj && ptool = x && pargs = a then                     (* 7c, 7e, 7f *)
  event Accept(r, l, x, a, pj).

(* One process per chain length 1..4; step 5 (len = leaf.del_depth + 1)
   holds by construction of the depth checks.  AcceptedRoot/AcceptedLink
   are emitted once steps 1-5 pass, before the leaf and PoP steps, so P1
   covers every chain that passes the chain checks, accepted or not. *)
let Verifier(i5: bool, i6: bool) =
  (! in(c, (s0: bitstring, x: tool, a: bitstring, pop: bitstring));
     let r = check_root(s0) in
     event AcceptedRoot(r);
     Leaf(i6, r, r, x, a, pop))
  |
  (! in(c, (s0: bitstring, s1: bitstring, x: tool, a: bitstring, pop: bitstring));
     let r = check_root(s0) in
     let t1 = check_link(i5, r, s1) in
     event AcceptedRoot(r);
     event AcceptedLink(r, t1);
     Leaf(i6, r, t1, x, a, pop))
  |
  (! in(c, (s0: bitstring, s1: bitstring, s2: bitstring, x: tool, a: bitstring, pop: bitstring));
     let r = check_root(s0) in
     let t1 = check_link(i5, r, s1) in
     let t2 = check_link(i5, t1, s2) in
     event AcceptedRoot(r);
     event AcceptedLink(r, t1);
     event AcceptedLink(t1, t2);
     Leaf(i6, r, t2, x, a, pop))
  |
  (! in(c, (s0: bitstring, s1: bitstring, s2: bitstring, s3: bitstring, x: tool, a: bitstring, pop: bitstring));
     let r = check_root(s0) in
     let t1 = check_link(i5, r, s1) in
     let t2 = check_link(i5, t1, s2) in
     let t3 = check_link(i5, t2, s3) in
     event AcceptedRoot(r);
     event AcceptedLink(r, t1);
     event AcceptedLink(t1, t2);
     event AcceptedLink(t2, t3);
     Leaf(i6, r, t3, x, a, pop)).
